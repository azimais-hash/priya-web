{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "python3 -m pip install --quiet --target /tmp/pydeps markdown && PYTHONPATH=/tmp/pydeps python3 build.py",
  "redirects": [
    {
      "source": "/general-7",
      "destination": "/reclamation",
      "permanent": true
    },
    {
      "source": "/general-6",
      "destination": "/for-organisations",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product-page/mindfulness-affirmation-cards",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/all-products",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/free-coaching",
      "destination": "/mindfully-priya-booking",
      "permanent": true
    },
    {
      "source": "/event-details/a-mindful-journey-for-new-mums-6-weeks-1",
      "destination": "/event-list",
      "permanent": true
    },
    {
      "source": "/event-details/mindfully-you-a-calm-space-for-new-mums-6-weeks",
      "destination": "/event-list",
      "permanent": true
    },
    {
      "source": "/event-details/online-mindfully-you-a-calm-space-for-new-mums",
      "destination": "/event-list",
      "permanent": true
    },
    {
      "source": "/service-page/beyond-mum-becoming-mindfully-me-again",
      "destination": "/one-to-one-coaching-programs",
      "permanent": true
    }
  ]
}
